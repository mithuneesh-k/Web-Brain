{
  "manifest_version": 3,
  "name": "Ozer Local Agent",
  "version": "1.0.0",
  "description": "On-device Visual Perception for Light-weight Browser Agents (SIH26171)",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["http://localhost:11434/*", "<all_urls>"],
  "permissions": ["activeTab", "scripting"]
}
